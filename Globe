vec2 globe(vec2 uv,float size,float waves,float spin){
    float i = iTime;
    float d = length(uv);
    float a = atan(uv.y,uv.x);
    uv = vec2(cos(a),sin(a))*mix(d,d*(1.0-(d/(size/2.0)*(3.0+sin(cos(a+spin)*d*10.0+i)*0.2*waves))*3.0+1.0),step(d/(size/2.0)*(3.0+sin(cos(a+spin)*d*10.0+i)*0.2*waves),0.65));
    return uv;
}
